{
  "name": "higher-ground-discovery",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run data:check && npm run lint:numbers",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "data:check": "tsx scripts/validate-data.ts",
    "data:docs": "tsx scripts/gen-docs.ts",
    "lint:numbers": "tsx scripts/lint-numbers.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts && tsx scripts/contact-sheet.ts",
    "data:build": "tsx data-src/build-data.ts && tsx data-src/build-qa.ts"
  },
  "dependencies": {
    "@fontsource-variable/anek-devanagari": "5.3.0",
    "@fontsource-variable/anek-latin": "5.3.0",
    "fuse.js": "7.5.0",
    "lucide-react": "1.55.0",
    "lz-string": "1.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
